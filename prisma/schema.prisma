generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ユーザー
// ============================================
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // bcrypt hash
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ワークスペース
  ownedWorkspaces    Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers   WorkspaceMember[]

  // チャンネル
  createdChannels    Channel[]         @relation("ChannelCreator")
  channelMembers     ChannelMember[]

  // メッセージ
  messages           Message[]

  // DM
  dmMembers          DmMember[]

  // ファイル
  files              File[]

  @@map("users")
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

// ============================================
// ワークスペース（マルチテナント）
// ============================================
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members          WorkspaceMember[]
  channels         Channel[]
  dms              DirectMessage[]
  invites          Invite[]
  externalContacts ExternalContact[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================
// 招待リンク
// ============================================
model Invite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  token       String    @unique @default(cuid())
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invites")
}

// ============================================
// チャンネル
// ============================================
model Channel {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  isPrivate   Boolean  @default(false) @map("is_private")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User                 @relation("ChannelCreator", fields: [createdBy], references: [id])
  members     ChannelMember[]
  messages    Message[]
  aiSummaries AiSummary[]
  emailConfig ChannelEmailConfig?

  @@unique([workspaceId, name])
  @@map("channels")
}

model ChannelMember {
  channelId  String    @map("channel_id")
  userId     String    @map("user_id")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_members")
}

// ============================================
// メッセージ
// ============================================
model Message {
  id        String   @id @default(cuid())
  channelId String   @map("channel_id")
  userId    String   @map("user_id")
  content   String
  threadId  String?  @map("thread_id")
  isAi      Boolean  @default(false) @map("is_ai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  parent       Message?      @relation("Thread", fields: [threadId], references: [id])
  replies      Message[]     @relation("Thread")
  files        File[]
  reactions    Reaction[]
  emailMessage EmailMessage?

  @@index([channelId, createdAt])
  @@map("messages")
}

// ============================================
// リアクション
// ============================================
model Reaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("reactions")
}

// ============================================
// ダイレクトメッセージ
// ============================================
model DirectMessage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   DmMember[]

  @@map("direct_messages")
}

model DmMember {
  dmId   String @map("dm_id")
  userId String @map("user_id")

  dm   DirectMessage @relation(fields: [dmId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([dmId, userId])
  @@map("dm_members")
}

// ============================================
// ファイル
// ============================================
model File {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  filename  String
  url       String
  size      Int
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("files")
}

// ============================================
// AI要約
// ============================================
model AiSummary {
  id          String   @id @default(cuid())
  channelId   String   @map("channel_id")
  summary     String
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  tokenCount  Int      @default(0) @map("token_count")
  createdAt   DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, periodEnd])
  @@map("ai_summaries")
}

// ============================================
// メール連携設定（チャンネルごと）
// ============================================
model ChannelEmailConfig {
  id           String   @id @default(cuid())
  channelId    String   @unique @map("channel_id")

  // IMAP受信設定
  imapHost     String   @map("imap_host")
  imapPort     Int      @default(993) @map("imap_port")
  imapUser     String   @map("imap_user")
  imapPass     String   @map("imap_pass") // AES-256-GCM encrypted
  imapTls      Boolean  @default(true) @map("imap_tls")

  // SMTP送信設定
  smtpHost     String   @map("smtp_host")
  smtpPort     Int      @default(587) @map("smtp_port")
  smtpUser     String   @map("smtp_user")
  smtpPass     String   @map("smtp_pass") // AES-256-GCM encrypted
  smtpTls      Boolean  @default(true) @map("smtp_tls")

  // 表示用
  emailAddress String   @map("email_address")
  displayName  String?  @map("display_name")

  // ポーリング制御
  lastSyncUid  String?  @map("last_sync_uid")
  lastSyncAt   DateTime? @map("last_sync_at")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_email_configs")
}

// ============================================
// 外部メール連絡先（Aibouアカウント不要）
// ============================================
model ExternalContact {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  email       String
  displayName String   @map("display_name")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]

  @@unique([workspaceId, email])
  @@map("external_contacts")
}

// ============================================
// メールメッセージ（メール固有情報）
// ============================================
model EmailMessage {
  id               String         @id @default(cuid())
  messageId        String         @unique @map("message_id")

  emailMessageId   String?        @map("email_message_id") // RFC Message-ID
  inReplyTo        String?        @map("in_reply_to")
  references       String?
  subject          String?
  fromEmail        String         @map("from_email")
  toEmails         String         @map("to_emails")  // JSON array
  ccEmails         String?        @map("cc_emails")   // JSON array
  direction        EmailDirection

  externalContactId String?       @map("external_contact_id")

  createdAt        DateTime       @default(now()) @map("created_at")

  message          Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  externalContact  ExternalContact? @relation(fields: [externalContactId], references: [id])

  @@index([emailMessageId])
  @@map("email_messages")
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}
